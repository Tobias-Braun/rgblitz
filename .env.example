DOMAIN=rgx.example.com
NUXT_PUBLIC_API_BASE=https://rgx.example.com/api

# Which image tag to deploy: "latest" tracks main, or pin to a release like "1.2.3"
IMAGE_TAG=latest

# Path to a docker config.json on the host that's already logged into ghcr.io
# (run `docker login ghcr.io` once with a read:packages PAT, then point this at
# the resulting file, e.g. $HOME/.docker/config.json). Only needed if the
# rgblitz packages are private; omit/leave unset if they're public.
DOCKER_CONFIG_FILE=/home/deploy/.docker/config.json
